# Copy to .env and fill in. .env is gitignored; never commit keys.
DEEPGRAM_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional overrides
# GROQ_MODEL=whisper-large-v3-turbo      # or whisper-large-v3
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=                     # e.g. en; empty = auto-detect
# GEMINI_MODEL=gemini-3.8-flash
# DEEPGRAM_USD_PER_MIN=0.0043            # check current pricing page
